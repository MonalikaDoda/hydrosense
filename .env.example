# Backend
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
DEMO_MODE=true
STORAGE_BACKEND=json
STORAGE_PATH=data/hydrosense.json

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
# Required for a production build; use outputs from infrastructure/backend.yaml
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
VITE_COGNITO_DOMAIN=

# AWS placeholders - never put real credentials in this file
AWS_REGION=ap-south-1
DYNAMODB_READINGS_TABLE=hydrosense-readings-dev
DYNAMODB_INCIDENTS_TABLE=hydrosense-incidents-dev
DYNAMODB_REPORTS_TABLE=hydrosense-reports-dev
DYNAMODB_MAX_SCAN_ITEMS=1000
# Future integration placeholders; not used by the current runtime
DYNAMODB_ALERTS_TABLE=hydrosense-alerts-dev
SOURCE_DATA_BUCKET=hydrosense-source-data-dev
SNS_TOPIC_ARN=
IOT_TOPIC=hydrosense/devices/+/readings

# Prototype configuration
CONTAINER_HEIGHT_CM=30
WATER_ALERT_THRESHOLD_CM=24
ALERT_COOLDOWN_SECONDS=300
MAX_READING_AGE_SECONDS=900
MAX_READING_FUTURE_SKEW_SECONDS=600
FORECAST_REQUEST_TIMEOUT_SECONDS=3
FORECAST_CACHE_SECONDS=600
FORECAST_STALE_CACHE_SECONDS=1800
# Optional reviewed dataset directory. Leave unset to keep the underpass module unavailable.
UNDERPASS_DATA_DIR=
DEMO_LATITUDE=28.6139
DEMO_LONGITUDE=77.2090
